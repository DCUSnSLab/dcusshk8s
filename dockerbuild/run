#!/usr/bin/env python3
import fcntl
import json
import os
import select
import shlex
import signal
import socket
import struct
import subprocess
import sys
import termios
import time as _time
import tty
from urllib.parse import urljoin

import requests


CONTROLLER_URL = os.getenv("CONTROLLER_URL", "http://controller-service:9001")
USER_POD = os.getenv("HOSTNAME", "unknown")
DEFAULT_TCP_PORT = 8081

GREEN = "\033[0;32m"
RED = "\033[0;31m"
YELLOW = "\033[1;33m"
RESET = "\033[0m"


def _env_float(name, default):
    try:
        return float(os.getenv(name, default))
    except Exception:
        return float(default)


EXECUTE_REQUEST_TIMEOUT_SECONDS = _env_float("RUN_EXECUTE_REQUEST_TIMEOUT_SECONDS", "10")
TICKET_POLL_REQUEST_TIMEOUT_SECONDS = _env_float("RUN_TICKET_POLL_REQUEST_TIMEOUT_SECONDS", "10")
TICKET_WAIT_TIMEOUT_SECONDS = _env_float("RUN_TICKET_WAIT_TIMEOUT_SECONDS", "1800")
TICKET_POLL_INTERVAL_SECONDS = _env_float("RUN_TICKET_POLL_INTERVAL_SECONDS", "1.0")
CANCEL_REQUEST_TIMEOUT_SECONDS = _env_float("RUN_CANCEL_REQUEST_TIMEOUT_SECONDS", "5")
RELEASE_REQUEST_TIMEOUT_SECONDS = _env_float("RUN_RELEASE_REQUEST_TIMEOUT_SECONDS", "2")


compute_pod = None
session_state = {
    "status": None,
    "ticket_id": None,
    "ticket_url": None,
    "cancel_url": None,
    "release_url": None,
    "compute_pod": None,
    "compute_pod_ip": None,
    "tcp_port": DEFAULT_TCP_PORT,
    "user_pod": USER_POD,
    "command": None,
}
_cleanup_completed = False
_cleanup_failed = False
_execute_request_in_flight = False
_controller_response_pending = False
_deferred_signal_exit_code = None
_deferred_signal_signum = None


def _set_session_state(**kwargs):
    session_state.update(kwargs)


def _absolute_url(path, default_path):
    target = path or default_path
    return urljoin(CONTROLLER_URL.rstrip("/") + "/", str(target).lstrip("/"))


def _safe_json(response):
    try:
        data = response.json()
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _normalize_status(data, response=None):
    raw_status = ""
    for key in ("status", "phase", "state", "ticket_status"):
        value = data.get(key)
        if isinstance(value, str) and value.strip():
            raw_status = value.strip().lower()
            break

    ticket = data.get("ticket")
    if isinstance(ticket, dict):
        ticket_status = ticket.get("status")
        if isinstance(ticket_status, str) and ticket_status.strip():
            normalized_ticket_status = ticket_status.strip().lower()
            if raw_status in {"", "success", "ok"}:
                raw_status = normalized_ticket_status

    if not raw_status and response is not None:
        if response.status_code == 202:
            raw_status = "queued"
        elif response.status_code == 404:
            raw_status = "failed"
        elif response.status_code == 410:
            raw_status = "cancelled"

    if raw_status in {"ok", "success", "assigned"}:
        if data.get("compute_pod") or data.get("compute_pod_ip"):
            return "assigned"
        return "success"
    if raw_status in {"canceled"}:
        return "cancelled"
    return raw_status


def _get_ticket_id(data):
    ticket_id = data.get("ticket_id")
    if ticket_id is not None:
        return str(ticket_id)

    ticket = data.get("ticket")
    if isinstance(ticket, dict) and ticket.get("ticket_id") is not None:
        return str(ticket.get("ticket_id"))

    return None


def _get_compute_info(data):
    ticket = data.get("ticket")
    if not isinstance(ticket, dict):
        ticket = {}

    compute_pod_value = (
        data.get("compute_pod")
        or ticket.get("compute_pod")
    )
    compute_pod_ip_value = (
        data.get("compute_pod_ip")
        or ticket.get("compute_pod_ip")
    )
    tcp_port_value = data.get("tcp_port") or DEFAULT_TCP_PORT
    return compute_pod_value, compute_pod_ip_value, tcp_port_value


def _user_pod_ip_from_env():
    for key in ("USER_POD_IP", "POD_IP", "MY_POD_IP"):
        value = os.getenv(key, "").strip()
        if value:
            return value
    return ""


def _extract_ticket_urls(data, ticket_id):
    ticket_url = data.get("poll_url") or data.get("ticket_url")
    cancel_url = data.get("cancel_url")
    release_url = data.get("release_url")

    if not ticket_url and ticket_id:
        ticket_url = f"/api/ticket/{ticket_id}/"
    if not cancel_url and ticket_id:
        cancel_url = f"/api/ticket/{ticket_id}/cancel/"
    if not release_url:
        release_url = "/api/compute/release/"

    ticket_default = f"/api/ticket/{ticket_id}/" if ticket_id else "/api/ticket/"
    cancel_default = f"/api/ticket/{ticket_id}/cancel/" if ticket_id else "/api/ticket/"
    return (
        _absolute_url(ticket_url, ticket_default),
        _absolute_url(cancel_url, cancel_default),
        _absolute_url(release_url, "/api/compute/release/"),
    )


def _request_json(method, url, payload=None, timeout=10):
    kwargs = {"timeout": timeout}
    if payload is not None:
        kwargs["json"] = payload

    if method == "GET":
        response = requests.get(url, **kwargs)
    else:
        response = requests.post(url, **kwargs)
    return response, _safe_json(response)


def _is_controller_unavailable_error(exc):
    return isinstance(exc, requests.RequestException)


def _describe_poll_error(exc):
    if exc is None:
        return ""

    if isinstance(exc, requests.RequestException):
        response = getattr(exc, "response", None)
        if response is not None:
            status_code = getattr(response, "status_code", None)
            reason = getattr(response, "reason", "") or ""
            summary = f"{exc.__class__.__name__}: "
            if status_code:
                summary += f"HTTP {status_code}"
                if reason:
                    summary += f" {reason}"
            else:
                summary += str(exc)
            return summary
        return f"{exc.__class__.__name__}: {exc}"

    return f"{exc.__class__.__name__}: {exc}"


def _best_effort_post(url_candidates, payload, timeout, label):
    last_error = None
    for attempt in range(3):
        for url in url_candidates:
            if not url:
                continue
            try:
                response = requests.post(url, json=payload, timeout=timeout)
                if response.status_code < 400:
                    return True
                last_error = RuntimeError(f"{label} failed with {response.status_code}: {response.text}")
            except Exception as exc:
                last_error = exc
        if attempt < 2:
            _time.sleep(0.5)

    if last_error:
        print(f"{YELLOW}[WARN]{RESET} {label} request failed: {last_error}")
    return False


def _cancel_ticket(reason):
    ticket_id = session_state.get("ticket_id")
    if not ticket_id:
        return False

    status = (session_state.get("status") or "").lower()
    if status in {"assigned", "failed", "cancelled"}:
        return False

    ticket_url = session_state.get("ticket_url") or _absolute_url(None, f"/api/ticket/{ticket_id}/")
    cancel_url = session_state.get("cancel_url") or _absolute_url(None, f"/api/ticket/{ticket_id}/cancel/")
    payload = {
        "ticket_id": ticket_id,
        "user_pod": session_state.get("user_pod"),
        "reason": reason,
        "command": session_state.get("command"),
    }
    return _best_effort_post(
        [cancel_url, f"{ticket_url.rstrip('/')}/cancel/"],
        payload,
        CANCEL_REQUEST_TIMEOUT_SECONDS,
        "cancel ticket",
    )


def _release_compute_pod(reason):
    compute_pod_value = session_state.get("compute_pod") or compute_pod
    if not compute_pod_value:
        return False

    release_url = session_state.get("release_url") or _absolute_url(None, "/api/compute/release/")
    payload = {
        "compute_pod": compute_pod_value,
        "ticket_id": session_state.get("ticket_id"),
        "user_pod": session_state.get("user_pod"),
        "reason": reason,
        "source": "user_release",
    }
    return _best_effort_post([release_url], payload, RELEASE_REQUEST_TIMEOUT_SECONDS, "release compute pod")


def _handle_cleanup(reason):
    status = (session_state.get("status") or "").lower()
    if status in {"failed", "cancelled"}:
        return True

    cleanup_ok = True
    if status == "assigned" or session_state.get("compute_pod") or compute_pod:
        cleanup_ok = _release_compute_pod(reason) and cleanup_ok
    elif session_state.get("ticket_id"):
        cleanup_ok = _cancel_ticket(reason) and cleanup_ok
    return cleanup_ok


def _wait_for_assignment(ticket_url):
    deadline = _time.monotonic() + TICKET_WAIT_TIMEOUT_SECONDS
    last_error = None
    last_error_summary = ""
    controller_unavailable_warned = False
    other_poll_error_warned = False

    while _time.monotonic() < deadline:
        try:
            response, data = _request_json("GET", ticket_url, timeout=TICKET_POLL_REQUEST_TIMEOUT_SECONDS)
            status = _normalize_status(data, response)

            if status in {"assigned", "success"}:
                compute_pod_value, compute_pod_ip_value, tcp_port_value = _get_compute_info(data)
                if compute_pod_value and compute_pod_ip_value:
                    _set_session_state(
                        status="assigned",
                        compute_pod=compute_pod_value,
                        compute_pod_ip=compute_pod_ip_value,
                        tcp_port=tcp_port_value,
                    )
                    return "assigned", data

            if status in {"failed", "cancelled"}:
                _set_session_state(status=status)
                return status, data

            if status in {"queued", "allocating"}:
                _set_session_state(status=status)
                retry_after_ms = data.get("retry_after_ms") or data.get("retry_after")
                sleep_seconds = TICKET_POLL_INTERVAL_SECONDS
                try:
                    if retry_after_ms is not None:
                        retry_after_seconds = float(retry_after_ms) / 1000.0
                        if retry_after_seconds > 0:
                            sleep_seconds = retry_after_seconds
                except Exception:
                    pass
                _time.sleep(max(0.2, sleep_seconds))
                continue

            compute_pod_value, compute_pod_ip_value, tcp_port_value = _get_compute_info(data)
            if compute_pod_value and compute_pod_ip_value:
                _set_session_state(
                    status="assigned",
                    compute_pod=compute_pod_value,
                    compute_pod_ip=compute_pod_ip_value,
                    tcp_port=tcp_port_value,
                )
                return "assigned", data

            last_error = RuntimeError(f"Unexpected ticket response: {data}")
            last_error_summary = _describe_poll_error(last_error)
        except Exception as exc:
            last_error = exc
            last_error_summary = _describe_poll_error(exc)
            if not controller_unavailable_warned and _is_controller_unavailable_error(exc):
                print(f"{YELLOW}[INFO]{RESET} Controller temporarily unavailable, retrying...")
                controller_unavailable_warned = True
            elif not other_poll_error_warned:
                print(f"{YELLOW}[INFO]{RESET} Ticket polling encountered an unexpected error, retrying...")
                other_poll_error_warned = True
            _time.sleep(TICKET_POLL_INTERVAL_SECONDS)

    return "timeout", {"error": last_error, "last_error": last_error_summary}


def _format_poll_failure_message(poll_data):
    if not isinstance(poll_data, dict):
        return ""

    message = poll_data.get("last_error") or poll_data.get("error")
    if message is None:
        return ""
    return str(message).strip()


def cleanup(signum=None, frame=None, exit_code=None):
    global _cleanup_completed, _cleanup_failed, _deferred_signal_exit_code, _deferred_signal_signum

    if signum is not None and exit_code is None:
        exit_code = 128 + int(signum)

    if (
        signum is not None
        and (_execute_request_in_flight or _controller_response_pending)
        and not session_state.get("ticket_id")
        and not session_state.get("compute_pod")
        and not compute_pod
    ):
        _deferred_signal_exit_code = exit_code
        _deferred_signal_signum = signum
        print(f"\n{YELLOW}[INFO]{RESET} Interrupt requested. Waiting for controller response before cleanup...")
        return False

    if _cleanup_completed:
        if exit_code is not None:
            raise SystemExit(exit_code)
        return not _cleanup_failed
    _cleanup_completed = True

    cleanup_ok = True
    if session_state.get("ticket_id"):
        current_status = (session_state.get("status") or "").lower()
        if current_status == "assigned" or session_state.get("compute_pod") or compute_pod:
            print(f"\n{YELLOW}[INFO]{RESET} Releasing compute pod...")
        else:
            print(f"\n{YELLOW}[INFO]{RESET} Cancelling queued ticket...")
        cleanup_ok = _handle_cleanup("signal" if signum is not None else "cleanup")

    _cleanup_failed = not cleanup_ok

    if exit_code is not None:
        raise SystemExit(exit_code)
    return cleanup_ok


def _register_signal_handlers():
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGHUP, cleanup)


def get_terminal_size():
    try:
        rows, cols = struct.unpack(
            "hh",
            fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, struct.pack("hhhh", 0, 0, 0, 0)),
        )
        return rows, cols
    except Exception:
        return 24, 80


def get_terminal_settings():
    try:
        attrs = termios.tcgetattr(sys.stdin.fileno())
        verase = attrs[6][termios.VERASE]
        if isinstance(verase, bytes) and len(verase) == 1:
            verase_val = ord(verase)
        elif isinstance(verase, int):
            verase_val = verase
        else:
            verase_val = 127
        return {"verase": verase_val}
    except Exception:
        return {"verase": 127}


def fix_ownership(marker_file):
    try:
        home = os.path.expanduser("~")
        if not os.path.exists(home) or not os.path.exists(marker_file):
            return

        ignores = [".git", ".hg", ".svn", "venv", ".env", "__pycache__"]
        runignore_path = os.path.join(home, ".runignore")
        if os.path.exists(runignore_path):
            try:
                with open(runignore_path, "r", encoding="utf-8") as handle:
                    for line in handle:
                        line = line.strip()
                        if line and not line.startswith("#"):
                            ignores.append(line)
            except Exception:
                pass

        find_cmd = ["find", home]
        for ignore in ignores:
            find_cmd.extend(["-name", ignore, "-prune", "-o"])
        find_cmd.extend([
            "-newer", marker_file,
            "-exec", "sudo", "chown", f"{os.getuid()}:{os.getgid()}", "{}", "+",
        ])

        subprocess.run(
            find_cmd,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def main():
    global compute_pod, _controller_response_pending, _execute_request_in_flight

    if os.getenv("RUN_SESSION"):
        print(f"{RED}[ERROR]{RESET} Cannot use 'run' inside a 'run' session")
        sys.exit(1)

    if len(sys.argv) < 2:
        print(f"Usage: run <command>")
        sys.exit(1)

    command = " ".join(shlex.quote(arg) for arg in sys.argv[1:])
    print(f"{GREEN}[INFO]{RESET} Requesting compute pod for: {command}")
    _set_session_state(command=command, user_pod=USER_POD)

    _register_signal_handlers()

    try:
        _controller_response_pending = True
        _execute_request_in_flight = True
        try:
            try:
                response = requests.post(
                    f"{CONTROLLER_URL}/api/execute/",
                    json={
                        "username": os.getenv("USER", "unknown"),
                        "command": command,
                        "user_pod": USER_POD,
                        "user_pod_ip": _user_pod_ip_from_env(),
                        "compute_type": os.getenv("COMPUTE_TYPE", "general"),
                    },
                    timeout=EXECUTE_REQUEST_TIMEOUT_SECONDS,
                )
            finally:
                _execute_request_in_flight = False

            data = _safe_json(response)
            status = _normalize_status(data, response)
            ticket_id = _get_ticket_id(data)
            ticket_url, cancel_url, release_url = _extract_ticket_urls(data, ticket_id)
            compute_pod_value, compute_pod_ip_value, tcp_port_value = _get_compute_info(data)

            _set_session_state(
                status=status or ("queued" if response.status_code == 202 else None),
                ticket_id=ticket_id,
                ticket_url=ticket_url,
                cancel_url=cancel_url,
                release_url=release_url,
                compute_pod=compute_pod_value,
                compute_pod_ip=compute_pod_ip_value,
                tcp_port=tcp_port_value,
                command=command,
                user_pod=USER_POD,
            )
        finally:
            _controller_response_pending = False

        if _deferred_signal_exit_code is not None:
            cleanup(signum=_deferred_signal_signum, exit_code=_deferred_signal_exit_code)

        if response.status_code == 202 or status in {"queued", "allocating"}:
            if not ticket_id:
                raise RuntimeError("Controller returned queued response without ticket_id")

            print(f"{GREEN}[INFO]{RESET} Ticket queued: {ticket_id}")
            print(f"{GREEN}[INFO]{RESET} Polling ticket status...")

            poll_status, poll_data = _wait_for_assignment(ticket_url)
            if poll_status != "assigned":
                if poll_status == "timeout":
                    print(f"{RED}[ERROR]{RESET} Ticket wait timed out")
                    timeout_message = _format_poll_failure_message(poll_data)
                    if timeout_message:
                        print(f"{RED}[ERROR]{RESET} Last polling error: {timeout_message}")
                    cleanup(exit_code=1)
                elif poll_status == "failed":
                    failed_message = (
                        _format_poll_failure_message(poll_data)
                        or poll_data.get("message")
                        or poll_data.get("error")
                    )
                    if failed_message:
                        print(f"{RED}[ERROR]{RESET} Ticket allocation failed: {failed_message}")
                    else:
                        print(f"{RED}[ERROR]{RESET} Ticket allocation failed")
                    sys.exit(1)
                elif poll_status == "cancelled":
                    print(f"{RED}[ERROR]{RESET} Ticket was cancelled")
                    sys.exit(1)
                else:
                    print(f"{RED}[ERROR]{RESET} Ticket ended unexpectedly: {poll_data}")
                    sys.exit(1)

            compute_pod = session_state.get("compute_pod")
            compute_pod_ip = session_state.get("compute_pod_ip")
            tcp_port = session_state.get("tcp_port", DEFAULT_TCP_PORT)
            if not compute_pod or not compute_pod_ip:
                raise RuntimeError("Ticket assigned without compute pod connection details")
        elif status in {"assigned", "success"} or (compute_pod_value and compute_pod_ip_value and response.ok):
            compute_pod = compute_pod_value
            compute_pod_ip = compute_pod_ip_value
            tcp_port = tcp_port_value
            _set_session_state(status="assigned", compute_pod=compute_pod, compute_pod_ip=compute_pod_ip, tcp_port=tcp_port)
        else:
            print(f"{RED}[ERROR]{RESET} {data.get('message') or data or 'Failed to allocate compute pod'}")
            sys.exit(1)

        print(f"{GREEN}[INFO]{RESET} Compute pod allocated: {compute_pod} ({compute_pod_ip})")
        print(f"{GREEN}[INFO]{RESET} Connecting to compute pod...")
    except requests.RequestException as exc:
        print(f"{RED}[ERROR]{RESET} Failed to allocate compute pod: {exc}")
        sys.exit(1)
    except Exception as exc:
        print(f"{RED}[ERROR]{RESET} Failed to allocate compute pod: {exc}")
        if session_state.get("ticket_id") or session_state.get("compute_pod"):
            cleanup(exit_code=1)
        sys.exit(1)

    sock = None
    old_tty = None
    session_completed_successfully = False
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.connect((compute_pod_ip, int(tcp_port)))

        rows, cols = get_terminal_size()
        settings = get_terminal_settings()
        header = {
            "command": command,
            "cwd": os.getcwd(),
            "rows": rows,
            "cols": cols,
            "term": os.getenv("TERM", "xterm-256color"),
            "settings": settings,
        }
        sock.sendall(f"{json.dumps(header)}\n".encode("utf-8"))

        old_tty = termios.tcgetattr(sys.stdin)
        marker_file = f"/tmp/run_marker_{os.getpid()}"
        with open(marker_file, "w", encoding="utf-8"):
            pass
        timestamp = _time.time() - 1
        os.utime(marker_file, (timestamp, timestamp))

        try:
            tty.setraw(sys.stdin.fileno())
            stdin_fd = sys.stdin.fileno()
            stdout_fd = sys.stdout.fileno()

            while True:
                ready, _, _ = select.select([sock, stdin_fd], [], [])
                if sock in ready:
                    data = sock.recv(4096)
                    if not data:
                        break
                    os.write(stdout_fd, data)
                if stdin_fd in ready:
                    data = os.read(stdin_fd, 1024)
                    if not data:
                        break
                    sock.sendall(data)
        finally:
            if old_tty is not None:
                termios.tcsetattr(sys.stdin, termios.TCSANOW, old_tty)
            print()
            fix_ownership(marker_file)
            try:
                if os.path.exists(marker_file):
                    os.remove(marker_file)
            except Exception:
                pass
        session_completed_successfully = True
    except Exception as exc:
        print(f"\n{RED}[ERROR]{RESET} Connection error: {exc}")
        if session_state.get("ticket_id") or session_state.get("compute_pod"):
            cleanup(exit_code=1)
        sys.exit(1)
    finally:
        if sock is not None:
            sock.close()
        active_exception = sys.exc_info()[1]
        cleanup(exit_code=None)
        if (
            _cleanup_failed
            and not isinstance(active_exception, SystemExit)
            and not session_completed_successfully
        ):
            raise SystemExit(1)


if __name__ == "__main__":
    main()
